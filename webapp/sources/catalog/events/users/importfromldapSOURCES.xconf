<?xml version="1.0" encoding="UTF-8"?>

<page>
  <property name="period">30m</property>
  <property name="enabled">true</property>
  <property name="eventname">Import LDAP user Sources</property>
  <path-action name="Script.run" allowduplicates="true">
    <script>/${catalogid}/events/scripts/users/importfromldapSOURCES.groovy</script>
  </path-action>
</page>
